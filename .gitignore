# =============================================================================
# REGRA DE WHITELIST ESTRITA:
# Ignora tudo por padrão na raiz e libera APENAS o que é reutilizável para
# reexecutar o sistema em outra máquina:
#   1. Modelos de inferência (models/)
#   2. Código-fonte e dependências da API (api-tcc/)
#   3. Documentação (docs/, README.md, INDEX.md, SECURITY.md)
# =============================================================================

/*

# -----------------------------------------------------------------------------
# 1. Raiz / Ambiente & Inicialização
# -----------------------------------------------------------------------------
!.gitignore
!.gitattributes
!.pylintrc
!.github/
!.github/**
!README.md
!INDEX.md
!SECURITY.md
!launcher.py
!iniciar_launcher.bat
!iniciar_launcher.sh
!parar_servicos.bat

# -----------------------------------------------------------------------------
# 2. Modelos de Inferência (models/)
# -----------------------------------------------------------------------------
!models/
!models/**
models/*.zip
models/*/train/

# -----------------------------------------------------------------------------
# 3. API e Ambiente Reutilizável (api-tcc/)
# -----------------------------------------------------------------------------
!api-tcc/
!api-tcc/**

# Ignorar segredos, dados locais de máquina, binários compilados, logs e caches
api-tcc/.env
api-tcc/.env.*
!api-tcc/.env.example
api-tcc/firebase-service-account.json
api-tcc/.venv/
api-tcc/.pytest_cache/
api-tcc/.vscode/
api-tcc/Ultralytics/
api-tcc/bin/
api-tcc/config/windows-services/
api-tcc/data/
api-tcc/logs/
api-tcc/models/
api-tcc/models_status.txt
api-tcc/training_artifacts/
api-tcc/temp_*
api-tcc/temp_test_*
api-tcc/*.dll

# -----------------------------------------------------------------------------
# 4. Documentação (docs/)
# -----------------------------------------------------------------------------
!docs/
!docs/**

# -----------------------------------------------------------------------------
# 5. Exclusões Globais de Cache, Bancos Locais e Sistema Operacional
# -----------------------------------------------------------------------------
**/__pycache__/
*.py[cod]
*$py.class
*.db
*.sqlite
*.sqlite3
.DS_Store
Thumbs.db
