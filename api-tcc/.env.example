# ============================================================================
# Exemplo de Configuração da API TCC — Copie este arquivo para ".env"
# NUNCA commite o arquivo ".env" real com segredos no repositório.
# ============================================================================

# --- SERVIDOR ---
HOST=0.0.0.0
PORT=8080
DEBUG=True

# Hosts permitidos (TrustedHostMiddleware) — inclua domínio/IP público em produção
ALLOWED_HOSTS=localhost,127.0.0.1

# Origins permitidas para CORS
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# --- MODELOS E DETECÇÃO ---
DETECTION_CONF_THRESHOLD=0.70
DETECTION_IOU_THRESHOLD=0.35
COUNT_DEDUP_IOU_THRESHOLD=0.5
VIDEO_INFERENCE_STRIDE=2
# Resolução de inferência (recomendados: 640, 1024, 1280)
DETECTION_IMAGE_SIZE=640
# Número de threads paralelas para inferência concorrente
DETECTION_MAX_WORKERS=4

# --- OLLAMA (Geração de Mensagens Personalizadas) ---
ENABLE_PERSONALIZED_MESSAGE=True
OLLAMA_COMMAND=ollama
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_TIMEOUT_SECONDS=10

# --- ARMAZENAMENTO ---
SAVE_TRAINING_ARTIFACTS=False
SAVE_PREDICTION_FILES=True
TRAINING_ARTIFACTS_DIR=training_artifacts

# ============================================================================
# SEGURANÇA — JWT E AUTENTICAÇÃO
# ============================================================================

# JWT de teste para desenvolvimento (apenas se habilitar /auth/test-token)
TEST_JWT_SECRET=gere_uma_chave_secreta_forte_para_testes_aqui

# JWT da própria API (OBRIGATÓRIO para /auth/token e /auth/google)
API_JWT_SECRET=gere_uma_chave_secreta_forte_de_producao_aqui

# Horas até o token da API expirar (padrão: 24h)
API_JWT_EXPIRE_HOURS=24

# ============================================================================
# PROTEÇÃO E RATE LIMITING
# ============================================================================

NOT_FOUND_MAX_HITS=4
NOT_FOUND_WINDOW_SECONDS=1
NOT_FOUND_BLOCK_SECONDS=300

AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW=60
AUTH_RATE_LIMIT_BLOCK=300

GLOBAL_RATE_LIMIT_MAX=60
GLOBAL_RATE_LIMIT_WINDOW=10
GLOBAL_RATE_LIMIT_BLOCK=300
GLOBAL_PERMANENT_BLACKLIST_ON_BURST=False
PERMANENT_BLACKLIST_FILE=logs/security/permanent_blacklist.txt
ENABLE_ADMIN_HONEYPOT=True
ADMIN_HONEYPOT_PATHS=/admin,/admin/,/admin-panel,/administrator,/wp-admin,/phpmyadmin
BLOCK_LOCAL_REQUESTS=False

# Limite do corpo da requisição (50 MB)
MAX_REQUEST_BODY_BYTES=52428800

# Limite de duração de vídeo (segundos)
MAX_VIDEO_DURATION_SECONDS=30

# Firebase App Check (em produção, configure como True)
ENABLE_APP_CHECK=False

# ============================================================================
# ADMIN/TESTE (use APENAS em desenvolvimento)
# ============================================================================
ALLOW_TEST_ADMIN_BYPASS_TOKEN=False
ADMIN_BYPASS_TOKEN=defina_um_token_admin_apenas_em_desenvolvimento

# ============================================================================
# DISPOSITIVO DE INFERÊNCIA (opcional: "cpu", "GPU", etc.)
# ============================================================================
# INFERENCE_DEVICE=cpu
